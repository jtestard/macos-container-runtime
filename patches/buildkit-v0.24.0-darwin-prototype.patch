new file mode 100644
index 0000000..f852053
--- /dev/null
+++ b/executor/darwinexecutor/executor.go
@@ -0,0 +1,99 @@
+//go:build darwin
+
+package darwinexecutor
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/moby/buildkit/executor"
+	resourcestypes "github.com/moby/buildkit/executor/resources/types"
+)
+
+// Executor is an early BuildKit integration probe. It executes shell-form RUN
+// instructions with the host shell and a snapshot directory as its working
+// directory. Seatbelt restricts file writes to that directory, but this does
+// not provide a chroot, arbitrary mounts, or Dockerfile absolute-path semantics.
+type Executor struct{}
+
+func New() executor.Executor { return &Executor{} }
+
+func (e *Executor) Run(ctx context.Context, _ string, rootfs executor.Mount, mounts []executor.Mount, process executor.ProcessInfo, started chan<- struct{}) (resourcestypes.Recorder, error) {
+	if len(mounts) != 0 {
+		return nil, fmt.Errorf("darwin prototype: RUN mounts are not supported")
+	}
+	if process.Meta.User != "" && process.Meta.User != "root" {
+		return nil, fmt.Errorf("darwin prototype: USER is not supported")
+	}
+	if process.Meta.ReadonlyRootFS {
+		return nil, fmt.Errorf("darwin prototype: readonly root is not supported")
+	}
+	if len(process.Meta.Args) < 2 || process.Meta.Args[0] != "/bin/sh" || process.Meta.Args[1] != "-c" {
+		return nil, fmt.Errorf("darwin prototype: only shell-form RUN is supported")
+	}
+	ref, err := rootfs.Src.Mount(ctx, false)
+	if err != nil {
+		return nil, err
+	}
+	rootMounts, release, err := ref.Mount()
+	if err != nil {
+		return nil, err
+	}
+	defer release()
+	if len(rootMounts) != 1 || rootMounts[0].Type != "bind" {
+		return nil, fmt.Errorf("darwin prototype: expected a native snapshot directory")
+	}
+	root := rootMounts[0].Source
+	if process.Meta.Cwd != "" && !filepath.IsAbs(process.Meta.Cwd) {
+		return nil, fmt.Errorf("darwin prototype: relative working directory is not supported")
+	}
+	cwd := filepath.Join(root, strings.TrimPrefix(filepath.Clean(process.Meta.Cwd), string(filepath.Separator)))
+	if process.Meta.Cwd == "" || process.Meta.Cwd == "/" {
+		cwd = root
+	}
+	rel, err := filepath.Rel(root, cwd)
+	if err != nil || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return nil, fmt.Errorf("darwin prototype: working directory escapes snapshot")
+	}
+	if err := os.MkdirAll(cwd, 0755); err != nil {
+		return nil, err
+	}
+	// This confines ordinary filesystem writes from RUN to the snapshot. It
+	// intentionally leaves reads and system services available for native
+	// tooling, so it is not a complete process isolation boundary.
+	profile := fmt.Sprintf("(version 1)(allow default)(deny file-write*)(allow file-write* (subpath %s))", strconv.Quote(root))
+	args := append([]string{"-p", profile, "/bin/sh"}, process.Meta.Args[1:]...)
+	command := exec.CommandContext(ctx, "/usr/bin/sandbox-exec", args...)
+	command.Dir = cwd
+	command.Env = process.Meta.Env
+	command.Stdin = process.Stdin
+	command.Stdout = process.Stdout
+	command.Stderr = process.Stderr
+	if err := command.Start(); err != nil {
+		return nil, err
+	}
+	if started != nil {
+		close(started)
+	}
+	err = command.Wait()
+	return noopRecorder{}, err
+}
+
+func (e *Executor) Exec(context.Context, string, executor.ProcessInfo) error {
+	return fmt.Errorf("darwin prototype: Exec is not supported")
+}
+
+type noopRecorder struct{}
+
+func (noopRecorder) Start() {}
+func (noopRecorder) Close() {}
+func (noopRecorder) CloseAsync(next func(context.Context) error) error {
+	return next(context.Background())
+}
+func (noopRecorder) Wait() error                               { return nil }
+func (noopRecorder) Samples() (*resourcestypes.Samples, error) { return &resourcestypes.Samples{}, nil }
