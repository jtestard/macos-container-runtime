@@ -0,0 +1,30 @@
+//go:build darwin
+
+package main
+
+import (
+	"context"
+
+	"github.com/moby/buildkit/worker"
+	"github.com/moby/buildkit/worker/base"
+	"github.com/moby/buildkit/worker/darwin"
+	"github.com/urfave/cli"
+)
+
+func init() {
+	registerWorkerInitializer(workerInitializer{fn: darwinWorkerInitializer, priority: 0})
+}
+
+func darwinWorkerInitializer(_ *cli.Context, common workerInitializerOpt) ([]worker.Worker, error) {
+	opt, err := darwin.NewWorkerOpt(common.config.Root)
+	if err != nil {
+		return nil, err
+	}
+	opt.BuildkitVersion = getBuildkitVersion()
+	opt.RegistryHosts = resolverFunc(common.config)
+	w, err := base.NewWorker(context.Background(), opt)
+	if err != nil {
+		return nil, err
+	}
+	return []worker.Worker{w}, nil
+}
