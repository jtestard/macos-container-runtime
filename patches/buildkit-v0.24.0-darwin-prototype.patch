diff --git a/worker/darwin/darwin.go b/worker/darwin/darwin.go
new file mode 100644
index 0000000..a1cfbbb
--- /dev/null
+++ b/worker/darwin/darwin.go
@@ -0,0 +1,81 @@
+//go:build darwin
+
+package darwin
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+
+	"github.com/containerd/containerd/v2/core/diff/apply"
+	ctdmetadata "github.com/containerd/containerd/v2/core/metadata"
+	"github.com/containerd/containerd/v2/core/snapshots"
+	"github.com/containerd/containerd/v2/plugins/content/local"
+	"github.com/containerd/containerd/v2/plugins/diff/walking"
+	"github.com/containerd/containerd/v2/plugins/snapshots/native"
+	"github.com/containerd/platforms"
+	"github.com/moby/buildkit/cache/metadata"
+	"github.com/moby/buildkit/executor/darwinexecutor"
+	containerdsnapshot "github.com/moby/buildkit/snapshot/containerd"
+	"github.com/moby/buildkit/util/leaseutil"
+	"github.com/moby/buildkit/util/network/netproviders"
+	"github.com/moby/buildkit/worker/base"
+	"github.com/moby/buildkit/worker/label"
+	ocispecs "github.com/opencontainers/image-spec/specs-go/v1"
+	bolt "go.etcd.io/bbolt"
+)
+
+// NewWorkerOpt wires the existing containerd native snapshotter and BuildKit
+// cache/export plumbing to a host-local Darwin executor.
+func NewWorkerOpt(root string) (base.WorkerOpt, error) {
+	var opt base.WorkerOpt
+	root = filepath.Join(root, "darwin-native")
+	if err := os.MkdirAll(root, 0700); err != nil {
+		return opt, err
+	}
+	store, err := local.NewStore(filepath.Join(root, "content"))
+	if err != nil {
+		return opt, err
+	}
+	snap, err := native.NewSnapshotter(filepath.Join(root, "snapshots"))
+	if err != nil {
+		return opt, err
+	}
+	db, err := bolt.Open(filepath.Join(root, "containerdmeta.db"), 0600, nil)
+	if err != nil {
+		return opt, err
+	}
+	mdb := ctdmetadata.NewDB(db, store, map[string]snapshots.Snapshotter{"native": snap})
+	if err := mdb.Init(context.Background()); err != nil {
+		return opt, err
+	}
+	content := containerdsnapshot.NewContentStore(mdb.ContentStore(), "buildkit")
+	id, err := base.ID(root)
+	if err != nil {
+		return opt, err
+	}
+	md, err := metadata.NewStore(filepath.Join(root, "metadata_v2.db"))
+	if err != nil {
+		return opt, err
+	}
+	net, _, err := netproviders.Providers(netproviders.Opt{Mode: "host"})
+	if err != nil {
+		return opt, err
+	}
+	return base.WorkerOpt{
+		ID:               id,
+		Root:             root,
+		Labels:           map[string]string{label.Executor: "darwin-host", label.Snapshotter: "native"},
+		Platforms:        []ocispecs.Platform{platforms.DefaultSpec()},
+		NetworkProviders: net,
+		Executor:         darwinexecutor.New(),
+		Snapshotter:      containerdsnapshot.NewSnapshotter("native", mdb.Snapshotter("native"), "buildkit", nil),
+		ContentStore:     content,
+		Applier:          apply.NewFileSystemApplier(content),
+		Differ:           walking.NewWalkingDiff(content),
+		LeaseManager:     leaseutil.WithNamespace(ctdmetadata.NewLeaseManager(mdb), "buildkit"),
+		GarbageCollect:   mdb.GarbageCollect,
+		MetadataStore:    md,
+		MountPoolRoot:    filepath.Join(root, "cachemounts"),
+	}, nil
+}
